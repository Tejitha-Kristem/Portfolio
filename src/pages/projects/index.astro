---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
---
<Base title="Work · Tejitha Kristem" description="Selected UI/UX work by Tejitha Kristem: EventGem, Food Rescue, Dear Wallet and LogRite.">
  <div class="page-hero">
    <div class="wrap">
      <span class="eyebrow mono">Work</span>
      <h1 class="page-title">Four projects, <em>zero</em> <span class="hand">boring bits.</span></h1>
      <p class="lede">Three are live and out in the wild, one is a concept I couldn't stop thinking about. Hover around, they don't bite.</p>
    </div>
  </div>
  <section style="padding-top: 10px">
    <div class="wrap">
      <ul class="plist">
        {projects.map((p) => (
          <li class="rise">
            <a class="prow" href={`/projects/${p.slug}`} data-thumb={p.thumb}>
              <span class="ptitle">{p.name}<span class="hl">{p.accent}</span></span>
              <span class="pline">{p.line}</span>
              <span class="pmeta">
                <span class="mono">{p.type}</span>
                <span class={p.live ? 'status-chip live' : 'status-chip'}>{p.live ? '● ' : ''}{p.status}</span>
              </span>
              <span class="pthumb"><img src={p.thumb} alt="" width="872" height="600" loading="lazy" /></span>
              <span class="parrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="peek" id="peek" aria-hidden="true"><img alt="" id="peekImg" /></div>
</Base>

<script>
  const peek = document.getElementById('peek');
  const img = document.getElementById('peekImg') as HTMLImageElement | null;
  const motionOK = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (peek && img && matchMedia('(hover: hover) and (min-width: 721px)').matches) {
    let x = 0, y = 0, cx = 0, cy = 0, on = false, raf = 0;
    const loop = () => {
      cx += (x - cx) * (motionOK ? 0.18 : 1);
      cy += (y - cy) * (motionOK ? 0.18 : 1);
      peek.style.transform = `translate3d(${cx + 28}px, ${cy - 120}px, 0) rotate(${on ? -3 : -6}deg) scale(${on ? 1 : 0.85})`;
      raf = requestAnimationFrame(loop);
    };
    document.querySelectorAll<HTMLAnchorElement>('.prow').forEach((row) => {
      row.addEventListener('pointerenter', (e) => {
        img.src = row.dataset.thumb || '';
        x = cx = e.clientX; y = cy = e.clientY; on = true;
        peek.classList.add('on');
        if (!raf) loop();
      });
      row.addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; });
      row.addEventListener('pointerleave', () => { on = false; peek.classList.remove('on'); });
    });
  }
</script>
