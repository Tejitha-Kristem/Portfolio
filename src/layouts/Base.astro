---
import '../styles/global.css';
import '../styles/pages.css';

interface Props {
  title: string;
  description: string;
  calm?: boolean; // case studies: quieter motion
}
const { title, description, calm = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/projects', label: 'Work', match: (p: string) => p.startsWith('/projects') },
  { href: '/about', label: 'About', match: (p: string) => p === '/about' },
  { href: '/resume', label: 'Resume', match: (p: string) => p === '/resume' },
];
const email = 'tejithakristem@gmail.com';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#FBFBF9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500..700&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&family=JetBrains+Mono:wght@400;600&family=Onest:wght@400..700&display=swap" />
    <script is:inline>
      try { const t = localStorage.getItem('tk-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body class={calm ? 'calm' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="progress-mobile" id="pm"></div>
    <svg class="vine" viewBox="0 0 58 1000" preserveAspectRatio="none" aria-hidden="true">
      <path class="stem" id="stem" d="M22 0 C 40 60, 6 120, 24 190 S 44 310, 20 380 S 4 500, 26 570 S 46 690, 22 760 S 6 880, 26 1000" />
      <g id="leaves"></g>
    </svg>

    <header class="top">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Tejitha Kristem, home">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20C4 10 10 4 20 4c0 10-6 16-16 16Z" fill="var(--leaf)"/><path d="M4 20 14 10" stroke="var(--paper)" stroke-width="1.6" stroke-linecap="round"/></svg>
          tejitha.k
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>)}
          <button class="theme-btn" id="themeBtn" type="button" aria-label="Switch to low-power dark mode" title="Low-power mode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="end">
      <div class="wrap">
        <span class="eyebrow mono">Say hi</span>
        <h2 class="reveal">Got a messy, real-world problem? <span class="hand">Let's untangle it.</span></h2>
        <div class="contact-row">
          <a class="email" href={`mailto:${email}`}>{email}</a>
          <button class="btn" type="button" data-copy={email}>Copy email</button>
        </div>
        <div class="contact-row socials">
          <a href="https://www.linkedin.com/in/tejitha-kristem-67740b162/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm7 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4V9.5Z"/></svg>LinkedIn</a>
          <a href="https://www.behance.net/tejithakristem" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.2 11.4c.9-.4 1.5-1.2 1.5-2.4C9.7 6.8 8.1 6 6 6H1v12h5.2c2.2 0 4.2-1 4.2-3.5 0-1.5-.8-2.7-2.2-3.1ZM3.4 8h2.3c.9 0 1.6.3 1.6 1.2 0 .9-.6 1.3-1.5 1.3H3.4V8Zm2.5 8H3.4v-3.3h2.5c1 0 1.8.4 1.8 1.7 0 1.2-.8 1.6-1.8 1.6ZM18 9.2c-2.8 0-4.6 2-4.6 4.5 0 2.7 1.7 4.5 4.6 4.5 2.1 0 3.6-1 4.2-3h-2.2c-.2.7-1 1.1-1.9 1.1-1.4 0-2.1-.8-2.1-2.1h6.4c.2-2.8-1.3-5-4.4-5Zm-2 3.5c.1-1.1.8-1.8 1.9-1.8 1.2 0 1.7.7 1.8 1.8H16ZM15.4 6.8h5v1.4h-5V6.8Z"/></svg>Behance</a>
          <a href="https://medium.com/@tejithakristem" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 12a6.75 6.75 0 1 1-13.5 0 6.75 6.75 0 0 1 13.5 0Zm7.4 0c0 3.5-1.5 6.4-3.4 6.4s-3.4-2.9-3.4-6.4 1.5-6.4 3.4-6.4 3.4 2.9 3.4 6.4ZM24 12c0 3.1-.5 5.7-1.2 5.7s-1.2-2.6-1.2-5.7.5-5.7 1.2-5.7S24 8.9 24 12Z"/></svg>Medium</a>
        </div>
        <div class="foot">
          <span>Tejitha Kristem · Messy problems in, calm products out ✿</span>
          <span><a href="/projects">Work</a> · <a href="/about">About</a> · <a href="/resume">Resume</a></span>
        </div>
      </div>
    </footer>
    <div class="toast" id="toast" role="status"></div>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
